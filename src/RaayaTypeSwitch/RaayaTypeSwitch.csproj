<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RaayaTypeSwitch</AssemblyName>
    <RootNamespace>RaayaTypeSwitch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Authors>Raaya TypeSwitch contributors</Authors>
    <Description>Local-first Persian and English keyboard layout correction for Windows.</Description>
    <RepositoryUrl>https://github.com/sam12r18/raaya-TypeSwitch</RepositoryUrl>
  </PropertyGroup>
</Project>
